<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Der Prompt-Maulwurf – S-KIPilot-Escape-Game für Fortgeschrittene</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F4F4; --surface:#FFFFFF; --surface2:#FAFAFA; --ink:#2E2E2E; --muted:#6B6B6B; --line:#DEDEDE;
  --red:#FF9B0F; --red-ink:#B05F00; --red-soft:#FFF1DC; --on-accent:#1E1E1E; --gold:#FF9B0F; --gold-soft:#FFF7EA;
  --ok:#2E8B57; --ok-soft:#E6F4EC; --door:#D6D6D6; --door2:#9A9A9A;
  --display:"Outfit", "Futura", "Avenir Next", "Segoe UI", system-ui, sans-serif;
  --body:"Nunito Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#262626; --surface:#313131; --surface2:#3A3A3A; --ink:#F2F2F2; --muted:#B5B5B5; --line:#4A4A4A;
    --red:#FF9B0F; --red-ink:#FFB65A; --red-soft:#3E2E18; --on-accent:#1E1E1E; --gold:#FF9B0F; --gold-soft:#3A2F1F;
    --ok:#5CCB91; --ok-soft:#1E3A2B; --door:#4A4A4A; --door2:#6E6E6E;
  }
}
:root[data-theme="dark"]{
  --bg:#262626; --surface:#313131; --surface2:#3A3A3A; --ink:#F2F2F2; --muted:#B5B5B5; --line:#4A4A4A;
    --red:#FF9B0F; --red-ink:#FFB65A; --red-soft:#3E2E18; --on-accent:#1E1E1E; --gold:#FF9B0F; --gold-soft:#3A2F1F;
    --ok:#5CCB91; --ok-soft:#1E3A2B; --door:#4A4A4A; --door2:#6E6E6E;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;overflow-x:hidden;-webkit-font-smoothing:antialiased}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}

/* Top bar */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:#fff;color:#3C3C3C;border-bottom:4px solid #FF9B0F;display:flex;align-items:center;gap:16px;padding:10px clamp(14px,3vw,32px);flex-wrap:wrap}
.bar .logo{height:34px;width:auto;display:block;flex:none}
.bar h1{color:#7A7A7A;font-weight:600!important;font-family:var(--display);font-weight:800;font-size:1.15rem;margin:0;letter-spacing:-.01em;flex:1 1 auto}
.bar .team{font-weight:600;opacity:.92}
.clock{font-family:var(--display);font-weight:700;font-size:1.35rem;font-variant-numeric:tabular-nums;background:#FF9B0F;color:#1E1E1E;padding:2px 12px;border-radius:999px;min-width:5.5ch;text-align:center}
.clock.warn{animation:pulse 1s infinite}
.clock.over{background:#3C3C3C;color:#fff}
@keyframes pulse{50%{background:#C66F00;color:#fff}}
.bar small{color:#6B6B6B;font-size:.85rem}
@media (max-width:560px){.bar h1{display:none}.bar .logo{height:28px}.bar .team{flex:1}}

/* Layout */
.stage{max-width:1100px;margin:0 auto;padding:clamp(16px,3vw,36px) clamp(14px,3vw,32px) 60px;display:grid;grid-template-columns:260px minmax(0,1fr);gap:clamp(20px,4vw,48px);align-items:start}
.vaultbox{position:sticky;top:90px;text-align:center}
.vaultbox svg{width:100%;max-width:240px;height:auto;display:block;margin:0 auto}
.vaultbox p{margin:10px 0 0;color:var(--muted);font-size:.95rem}
.vaultbox strong{color:var(--ink);font-family:var(--display);font-size:1.6rem;display:block;line-height:1.1}
@media (max-width:760px){
  .stage{grid-template-columns:1fr}
  .vaultbox{position:static;display:flex;align-items:center;gap:16px;text-align:left}
  .vaultbox svg{width:96px;margin:0}
  .vaultbox p{margin:0}
}

/* Vault SVG */
.bolt{fill:var(--door2);transition:fill .5s, transform .6s}
.bolt.open{fill:var(--red)}
.ring{fill:var(--surface);stroke:var(--line);stroke-width:6}
.door{fill:var(--door)}
.door-inner{fill:none;stroke:var(--door2);stroke-width:3}
.handle{transform-origin:100px 100px;transition:transform 1.6s cubic-bezier(.6,-0.2,.3,1.2)}
.handle line{stroke:#7A7A7A;stroke-width:8;stroke-linecap:round}
.handle circle{fill:#FF9B0F}
.vault.open .handle{transform:rotate(540deg)}
.vault.open .door-g{transform-origin:20px 100px;animation:swing 1.2s 1.5s forwards ease-in-out}
@keyframes swing{to{transform:perspective(400px) rotateY(-70deg)}}
.pig{opacity:0;transition:opacity .6s 2s}
.vault.open .pig{opacity:1}

/* Screen content */
.screen h2{font-family:var(--display);font-weight:700;font-size:clamp(1.7rem,4vw,2.5rem);line-height:1.08;letter-spacing:-.02em;margin:0 0 14px}
.screen h3{font-family:var(--display);font-weight:700;font-size:1.2rem;margin:28px 0 10px}
.kicker{color:var(--muted);font-weight:700;margin:0 0 6px;font-family:var(--display)}
.kicker::before{content:"\\";color:var(--red);font-weight:800;margin-right:8px;font-size:1.2em}
.lead{font-size:1.1rem;max-width:62ch}
.phantom{border-left:4px solid var(--red);background:var(--surface);padding:14px 18px;margin:0 0 22px;border-radius:0 12px 12px 0;display:flex;gap:12px;align-items:flex-start}
.phantom .ghost{font-size:1.6rem;line-height:1}
.phantom p{margin:0;font-style:italic}
.phantom b{font-style:normal;display:block;font-size:.85rem;color:var(--muted);font-weight:600}
.task{font-weight:700;font-size:1.08rem;margin:20px 0 12px}

/* Context pieces */
.chat{display:flex;flex-direction:column;gap:10px;margin:8px 0 6px}
.msg{max-width:88%;padding:10px 14px;border-radius:16px}
.msg.me{align-self:flex-end;background:var(--red);color:var(--on-accent);border-bottom-right-radius:4px}
.msg.ai{align-self:flex-start;background:var(--surface);border:1px solid var(--line);border-bottom-left-radius:4px}
.msg small{display:block;font-weight:700;font-size:.8rem;opacity:.75}
.file{display:flex;gap:14px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 16px;max-width:520px}
.file .ico{width:40px;height:48px;border-radius:6px;background:#2B579A;color:#fff;font-weight:800;display:grid;place-items:center;font-family:var(--display);flex:none}
.file .name{font-weight:600;word-break:break-all}
.file .meta{color:var(--muted);font-size:.9rem}
.doc{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:18px 22px;font-family:Georgia,"Times New Roman",serif;line-height:1.7;max-width:620px;box-shadow:6px 6px 0 var(--line)}
.doc .dh{font-family:var(--body);font-size:.85rem;color:var(--muted);margin-bottom:6px}

/* Options */
.opts{display:grid;gap:10px}
.opt{display:block;width:100%;text-align:left;background:var(--surface);border:2px solid var(--line);border-radius:12px;padding:12px 16px;cursor:pointer;transition:border-color .15s, background .15s}
.opt:hover:not(:disabled){border-color:var(--red)}
.opt .letter{font-family:var(--display);font-weight:800;color:var(--red-ink);margin-right:8px}
.opt.wrong{border-color:var(--red);background:var(--red-soft);cursor:default}
.opt.right{border-color:var(--ok);background:var(--ok-soft)}
.opt.sel{border-color:var(--red);background:var(--red-soft)}
.opt .why{display:block;margin-top:6px;font-size:.93rem;color:var(--ink)}
.opt:disabled{cursor:default}
label.opt{display:flex;gap:12px;align-items:flex-start}
label.opt input{width:20px;height:20px;margin-top:3px;accent-color:var(--red);flex:none}

.row{background:var(--surface);border:2px solid var(--line);border-radius:12px;padding:12px 16px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center}
.row.right{border-color:var(--ok);background:var(--ok-soft)}
.row.wrong{border-color:var(--red);background:var(--red-soft)}
.row .why{grid-column:1/-1;font-size:.93rem}
select{padding:8px 10px;border-radius:8px;border:2px solid var(--line);background:var(--surface2);min-width:140px}
.tf{display:flex;gap:6px}
.tf button{border:2px solid var(--line);background:var(--surface2);border-radius:999px;padding:6px 14px;cursor:pointer;font-weight:600}
.tf button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
@media (max-width:560px){.row{grid-template-columns:1fr}}

.group{margin-bottom:18px}
.group h4{margin:0 0 8px;font-family:var(--display);font-size:1.05rem}
.pills{display:flex;flex-wrap:wrap;gap:8px}
.pill{border:2px solid var(--line);background:var(--surface);border-radius:12px;padding:8px 14px;cursor:pointer;text-align:left;max-width:100%}
.pill[aria-pressed="true"]{border-color:var(--red);background:var(--red-soft)}
.pill.right{border-color:var(--ok);background:var(--ok-soft)}

/* Buttons & feedback */
.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px;align-items:center}
.btn{border:none;border-radius:4px;padding:12px 26px;font-weight:700;cursor:pointer;background:var(--red);color:var(--on-accent);font-family:var(--display);letter-spacing:.01em;font-size:1rem}
.btn:hover{filter:brightness(1.08)}
.btn.ghost{font-family:var(--body);background:transparent;color:var(--ink);border:2px solid var(--line)}
.btn.ghost:hover{border-color:var(--ink)}
.feedback{margin-top:16px;padding:12px 16px;border-radius:12px;display:none}
.feedback.show{display:block}
.feedback.bad{background:var(--red-soft)}
.feedback.good{background:var(--ok-soft)}
.hint{margin-top:16px;padding:12px 16px;border-radius:12px;background:var(--gold-soft);border:2px dashed var(--gold)}
.lesson{margin-top:22px;padding:20px 22px;border-radius:16px;background:var(--surface);border:2px solid var(--gold)}
.lesson{border-left-width:8px}
.lesson b{font-family:var(--display);font-size:1.1rem;display:block;margin-bottom:4px}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}

input[type=text]{width:100%;max-width:420px;padding:12px 14px;border-radius:12px;border:2px solid var(--line);background:var(--surface)}
.rules{display:grid;gap:8px;padding:0;margin:18px 0;list-style:none;max-width:62ch}
.rules li{padding-left:28px;position:relative}
.rules li::before{content:"\\";position:absolute;left:4px;color:var(--red);font-weight:800;font-family:var(--display);font-size:1.2em;line-height:1.3}
.prompt-out{background:var(--surface);border:2px solid var(--ok);border-radius:12px;padding:16px 18px;white-space:pre-wrap}
.stats{display:flex;gap:28px;flex-wrap:wrap;margin:16px 0}
.stats div{font-size:.95rem;color:var(--muted)}
.stats strong{display:block;font-family:var(--display);font-size:2rem;color:var(--ink);line-height:1.1}
.cheat{counter-reset:c;list-style:none;padding:0;display:grid;gap:10px}
.cheat li{background:var(--surface);border-radius:12px;padding:12px 16px 12px 52px;position:relative;border:1px solid var(--line)}
.cheat li::before{counter-increment:c;content:counter(c);position:absolute;left:14px;top:12px;width:26px;height:26px;border-radius:50%;background:var(--red);color:var(--on-accent);font-weight:800;display:grid;place-items:center;font-size:.9rem}
.foot{max-width:1100px;margin:0 auto;padding:0 clamp(14px,3vw,32px) 40px;color:var(--muted);font-size:.85rem}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:12px 20px;border-radius:12px;font-weight:600;z-index:20;max-width:90vw}
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important}}

/*EXTRA_CSS*/
.stage{grid-template-columns:minmax(0,1fr) 330px}
.board{position:sticky;top:90px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px}
.board h3{font-family:var(--display);font-size:1.1rem;margin:0 0 4px}
.board p.sub{margin:0 0 10px;font-size:.82rem;color:var(--muted)}
.sus-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.sus{min-width:0;overflow-wrap:break-word;hyphens:auto;text-align:left;border:2px solid var(--line);border-radius:10px;padding:8px;background:var(--surface2);cursor:pointer;position:relative;font-size:.8rem;line-height:1.3;font-family:var(--body)}
.sus .top{display:flex;gap:8px;align-items:center}
.av{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-weight:800;color:#1E1E1E;font-size:.78rem;flex:none;font-family:var(--display)}
.sus b{display:block;font-size:.85rem}
.tags{display:flex;flex-wrap:wrap;gap:3px;margin-top:6px}
.tags span{background:var(--bg);border-radius:4px;padding:1px 5px;font-size:.72rem}
.sus.out{opacity:.38}
.sus.out::after{content:"";position:absolute;inset:0;border-radius:8px;background:linear-gradient(to top right,transparent calc(50% - 2px),var(--red) calc(50% - 2px),var(--red) calc(50% + 2px),transparent calc(50% + 2px))}
.cluelist{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:6px;font-size:.84rem}
.cluelist li{border-radius:8px;padding:7px 10px;background:var(--red-soft)}
.cluelist li.empty{background:transparent;border:1px dashed var(--line);color:var(--muted)}
.clue-card{margin-top:16px;padding:16px 18px;border-radius:12px;background:var(--surface);border:2px dashed var(--red)}
.clue-card b{font-family:var(--display);display:block;margin-bottom:4px}
@media (max-width:860px){.stage{grid-template-columns:1fr}.board{position:static}}

.paper{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:18px 22px;box-shadow:6px 6px 0 var(--line);max-width:680px}
.paper .dh{font-size:.85rem;color:var(--muted);margin-bottom:8px}
.redact{font-family:Georgia,"Times New Roman",serif;line-height:2.15}
.tok{font:inherit;color:inherit;background:transparent;border:none;border-bottom:2px dotted var(--muted);padding:0 3px;cursor:pointer;border-radius:3px}
.tok:hover{background:var(--red-soft)}
.tok.red{background:var(--ink);color:var(--ink);border-bottom-color:var(--ink)}

.round{font-family:var(--display);font-weight:700;color:var(--muted);margin:0 0 6px}
.plines{display:grid;gap:6px;max-width:720px}
.pline{display:grid;grid-template-columns:2em 1fr;gap:8px;text-align:left;width:100%;background:var(--surface);border:2px solid var(--line);border-radius:8px;padding:8px 12px;cursor:pointer;font:inherit;color:inherit}
.pline:hover:not(:disabled){border-color:var(--red)}
.pline .no{font-family:var(--display);color:var(--red-ink);font-weight:800}
.pline.wrong{border-color:var(--red);background:var(--red-soft)}
.pline.right{border-color:var(--ok);background:var(--ok-soft)}
.pline:disabled{cursor:default}
.outbox{background:var(--surface);border-left:6px solid var(--red);padding:12px 16px;border-radius:0 10px 10px 0;margin:14px 0;max-width:720px}
.outbox small{display:block;font-weight:700;color:var(--muted)}
.tw{overflow-x:auto}
.outbox table{border-collapse:collapse;font-size:.9rem;margin-top:6px}
.outbox td,.outbox th{border:1px solid var(--line);padding:4px 8px;text-align:left}
.outbox tr.fake td{background:var(--red-soft)}

.tpl{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px 20px;line-height:2.3;max-width:720px}
.blank{font:inherit;color:inherit;min-width:8em;display:inline-block;border:none;border-bottom:3px solid var(--red);background:var(--red-soft);border-radius:6px 6px 0 0;padding:0 8px;cursor:pointer;line-height:1.7;text-align:left}
.blank.empty{color:var(--muted)}
.blank.right{border-color:var(--ok);background:var(--ok-soft)}
.blank.wrong{outline:2px solid var(--red)}
.bank{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chip{border:2px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 14px;cursor:pointer;font:inherit;color:inherit}
.chip.sel{background:var(--red);border-color:var(--red);color:var(--on-accent);font-weight:700}

.seq{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}
@media (max-width:640px){.seq{grid-template-columns:1fr}}
.seq h4{margin:0 0 8px;font-family:var(--display)}
.slots{display:grid;gap:8px;counter-reset:s}
.slot{min-height:58px;border:2px dashed var(--line);border-radius:10px;padding:10px 12px 10px 46px;position:relative;font:inherit;color:inherit;text-align:left;background:transparent;width:100%;font-size:.93rem}
.slot::before{counter-increment:s;content:counter(s);position:absolute;left:12px;top:12px;width:24px;height:24px;border-radius:50%;background:var(--red);color:var(--on-accent);display:grid;place-items:center;font-weight:800;font-size:.85rem}
.slot.filled{border-style:solid;background:var(--surface);cursor:pointer}
.slot.right{border-color:var(--ok);background:var(--ok-soft)}
.pool{display:grid;gap:8px}
.card{font:inherit;color:inherit;text-align:left;border:2px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 12px;cursor:pointer;font-size:.93rem}
.card:hover{border-color:var(--red)}

.mixer{display:grid;gap:8px;max-width:760px}
.sw{display:grid;grid-template-columns:52px 1fr;gap:12px;align-items:center;text-align:left;border:2px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 12px;cursor:pointer;font:inherit;color:inherit}
.sw .track{width:46px;height:26px;border-radius:13px;background:var(--line);position:relative;transition:background .2s}
.sw .track::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.3);transition:left .2s}
.sw[aria-checked="true"]{border-color:var(--red)}
.sw[aria-checked="true"] .track{background:var(--red)}
.sw[aria-checked="true"] .track::after{left:23px}
.testrun{margin-top:16px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px;max-width:760px}
.meter{height:14px;background:var(--line);border-radius:7px;overflow:hidden;margin:8px 0 12px}
.meter i{display:block;height:100%;background:var(--ok);transition:width .6s}
.meter.badm i{background:var(--red)}
.effects{list-style:none;padding:0;margin:0;display:grid;gap:6px;font-size:.93rem}

.lineup{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.lineup .sus{cursor:default;font-size:.88rem;padding:12px}
.lineup .btn{margin-top:10px;padding:8px 16px;font-size:.9rem;width:100%}
.kibar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-top:14px;max-width:680px;background:var(--surface);border:2px solid var(--line);border-radius:12px;padding:10px 14px;font-size:.93rem}
.sw.mini{grid-template-columns:46px auto;padding:6px 10px;border-width:2px}
</style>
</head>
<body>

<header class="bar">
  <img class="logo" alt="WG-DATA" src="data:image/png;base64,">
  <h1>Der Prompt-Maulwurf</h1>
  <span class="team" id="teamLabel"></span>
  <small id="clockLabel">bis zur Vorstandspräsentation</small>
  <span class="clock" id="clock">30:00</span>
</header>

<main class="stage">
  <section class="screen" id="screen" aria-live="polite"></section>
  <aside class="board" aria-label="Ermittlungstafel">
    <h3>Ermittlungstafel</h3>
    <p class="sub">Tippt Verdächtige an, um sie auszuschließen.</p>
    <div class="sus-grid" id="susGrid"></div>
    <ul class="cluelist" id="clueList"></ul>
  </aside>
</main>
<footer class="foot">Ein Lernspiel der WG-DATA GmbH rund um den S-KIPilot. Alle Personen und Daten sind frei erfunden.</footer>

<script>
/* ---------- Verdächtige & Spuren ---------- */
const SUSPECTS = [
  {n:"Konrad Klee", d:"Firmenkunden", c:"#9BC4E2", drink:"Kaffee", time:"Nachteule", way:"Auto", hand:"Rechtshand", floor:"2. OG"},
  {n:"Petra Portmann", d:"Vertrieb", c:"#F4B6C2", drink:"Tee", time:"Nachteule", way:"Auto", hand:"Linkshand", floor:"2. OG"},
  {n:"Theo Tannert", d:"Controlling", c:"#B8D8A8", drink:"Tee", time:"Frühaufsteher", way:"Fahrrad", hand:"Linkshand", floor:"2. OG"},
