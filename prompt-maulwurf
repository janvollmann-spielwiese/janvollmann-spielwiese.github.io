/* ---------- State ---------- */
const TOTAL = 30*60, HINT_COST = 60, WRONG_ACCUSE = 120;
const S = {team:"", st:-1, start:0, penalty:0, hints:0, clues:0, hintShown:false, done:false, endTime:0, overNotified:false, out:new Set(), accusations:0};
const $ = s => document.querySelector(s);
const screen = $("#screen");
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const shuffle = a => a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(x=>x[1]);
const fmt = s => { s=Math.max(0,Math.floor(s)); return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0"); };
const initials = n => n.split(" ").map(w=>w[0]).join("");

/* ---------- Ermittlungstafel ---------- */
function susCard(p, i, interactive){
  const tags = ["drink","time","way","hand","floor"].map(k=>`<span>${ICON[k][p[k]]} ${p[k]}</span>`).join("");
  const tag = interactive ? "button" : "div";
  return `<${tag} class="sus${S.out.has(i)?" out":""}" data-i="${i}" ${interactive?`aria-pressed="${S.out.has(i)}"`:""}>
    <div class="top"><span class="av" style="background:${p.c}">${initials(p.n)}</span><span><b>${p.n}</b>${p.d}</span></div>
    <div class="tags">${tags}</div></${tag}>`;
}
function drawBoard(){
  $("#susGrid").innerHTML = SUSPECTS.map((p,i)=>susCard(p,i,true)).join("");
  $("#susGrid").querySelectorAll(".sus").forEach(b => b.onclick = () => {
    const i = +b.dataset.i; S.out.has(i) ? S.out.delete(i) : S.out.add(i); drawBoard();
  });
  $("#clueList").innerHTML = CLUES.map((c,i)=> i < S.clues ? `<li><b>Spur ${i+1}:</b> ${c.short}</li>` : `<li class="empty">Spur ${i+1}: noch verborgen</li>`).join("");
}

/* ---------- Timer ---------- */
function elapsed(){ return S.start ? ((S.done ? S.endTime : Date.now()) - S.start)/1000 + S.penalty : 0; }
function tick(){
  if(!S.start) return;
  const rem = TOTAL - elapsed(), c = $("#clock");
  if(rem >= 0){
    c.textContent = fmt(rem); c.classList.toggle("warn", rem < 120); c.classList.remove("over");
    $("#clockLabel").textContent = "bis zur Vorstandspräsentation";
  } else {
    c.textContent = "+" + fmt(-rem); c.classList.add("over"); c.classList.remove("warn");
    $("#clockLabel").textContent = "Der Vorstand wartet! Verlängerung:";
    if(!S.overNotified && !S.done){ S.overNotified = true; toast("9:00 Uhr: Der Vorstand sitzt im Besprechungsraum. Egal, ermittelt weiter!"); }
  }
}
setInterval(tick, 500);
function toast(msg){ const t=document.createElement("div"); t.className="toast"; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),3800); }

/* ---------- Gemeinsame Bausteine ---------- */
function moleBox(text, label){ return `<div class="phantom"><span class="ghost">🕶️</span><p><b>${label || "Notiz vom Maulwurf"}</b>${text} <span style="font-style:normal">– M.</span></p></div>`; }
function header(L){
  return `<p class="kicker">Spur ${S.st+1} von 5</p><h2>${L.title}</h2>${moleBox(L.mole)}
    ${L.story ? `<p>${L.story}</p>` : ""}<p class="task">${L.task}</p>`;
}
function footer(checkLabel){
  return `<div class="actions">${checkLabel ? `<button class="btn" id="check">${checkLabel}</button>` : ""}
    <button class="btn ghost" id="hintBtn">Tipp holen (kostet 1 Minute)</button></div>
    <div id="hintBox"></div><div class="feedback" id="fb"></div><div id="after"></div>`;
}
function wireHint(text){
  $("#hintBtn").onclick = () => {
    if(S.hintShown) return;
    S.hintShown = true; S.hints++; S.penalty += HINT_COST; tick();
    $("#hintBox").innerHTML = `<div class="hint">💡 ${text}</div>`;
    $("#hintBtn").disabled = true; $("#hintBtn").style.opacity = .5;
  };
}
function feedback(msg, good){
  const fb = $("#fb"); fb.className = "feedback show " + (good ? "good" : "bad"); fb.innerHTML = msg;
  if(!good){ fb.classList.remove("shake"); void fb.offsetWidth; fb.classList.add("shake"); }
}
function solved(L){
  S.clues++; drawBoard();
  const c = CLUES[S.st];
  const chk = $("#check"); if(chk) chk.remove();
  const hb = $("#hintBtn"); if(hb) hb.remove();
  $("#fb").className = "feedback";
  const last = S.st === STATIONS.length - 1;
  $("#after").innerHTML = `<div class="lesson"><b>✅ Vorlage repariert! Euer Merksatz:</b>${L.lesson}</div>
    <div class="clue-card"><b>🔎 Spur ${S.st+1} gefunden</b>${c.text}<br><small style="color:var(--muted)">Steht jetzt auf eurer Ermittlungstafel. Schließt aus, wer nicht passt.</small></div>
    <div class="actions"><button class="btn" id="next">${last ? "Zur Entlarvung" : "Nächste Spur"}</button></div>`;
  $("#next").onclick = () => { S.st++; render(); window.scrollTo({top:0,behavior:"smooth"}); };
}

/* ---------- Intro ---------- */
function intro(){
  screen.innerHTML = `
    <p class="kicker">Ein Escape-Game für KI-Fortgeschrittene</p>
    <h2>Montag, 8:30 Uhr. Die Prompt-Bibliothek ist sabotiert.</h2>
    <p class="lead">Um 9:00 Uhr präsentiert ihr dem Vorstand eure Prompt-Bibliothek für den S-KIPilot: 40 geprüfte Vorlagen in einer Word-Datei, wochenlang verfeinert. Doch heute Morgen ist alles kaputt. Datenschutz-Schritte gelöscht, Widersprüche eingebaut, Einladungen zum Halluzinieren. Die Speicherhistorie verrät: Es war jemand aus dem Haus.</p>
    ${moleBox("Sechs Verdächtige, fünf Spuren, dreißig Minuten. Repariert meine Sabotage, wenn ihr könnt. Für jede reparierte Vorlage verrate ich euch etwas über mich. Ich bin ja fair.")}
    <ul class="rules">
      <li>Spielt zu zweit bis viert an einem Bildschirm. Diesmal wird's knifflig, also diskutiert ruhig ausführlich.</li>
      <li>Jede Station hat eine neue Spielmechanik: Schwärzen, Debuggen, Lückentext, Reihenfolge und Mischpult.</li>
      <li>Jede reparierte Vorlage bringt eine Spur. Nutzt die Ermittlungstafel und streicht aus, wer nicht passt.</li>
      <li>Tipps kosten eine Minute. Eine falsche Anklage am Ende kostet zwei.</li>
    </ul>
    <label for="team" style="font-weight:700;display:block;margin-bottom:6px">Wie heißt euer Ermittlungsteam?</label>
    <input type="text" id="team" maxlength="30" placeholder="z. B. Die Prompt-Profiler">
    <div class="actions"><button class="btn" id="go">Ermittlung starten</button></div>`;
  $("#go").onclick = () => {
    S.team = $("#team").value.trim() || "Team Spürnase";
    $("#teamLabel").textContent = S.team;
    S.start = Date.now(); S.st = 0; render();
  };
  $("#team").addEventListener("keydown", e => { if(e.key === "Enter") $("#go").click(); });
}

/* ---------- Renderer ---------- */
function render(){
  S.hintShown = false;
  if(S.st >= STATIONS.length) return accuse();
  const L = STATIONS[S.st];
  ({redact, debug, cloze, sequence, mixer})[L.type](L);
  wireHint(L.hint);
}

function redact(L){
  let i = 0;
  const body = L.segs.map(s => typeof s === "string" ? esc(s) : `<button class="tok" data-k="${i++}" data-p="${s.p?1:0}" aria-pressed="false">${esc(s.t)}</button>`).join("");
  screen.innerHTML = header(L) + `<div class="paper"><div class="dh">Gesprächsnotiz.docx</div><div class="redact">${body}</div></div>
    <div class="kibar"><span>🤖 <b>S-KIPilot</b> · Fasse die Notiz in drei Stichpunkten für meine Urlaubsvertretung zusammen.</span>
    <button class="sw mini" role="switch" aria-checked="true" id="pubSearch"><span class="track"></span><span>Öffentliche Suche</span></button></div>` + footer("Startklar? Prüfen");
  $("#pubSearch").onclick = e => { const b=e.currentTarget; b.setAttribute("aria-checked", b.getAttribute("aria-checked")==="true" ? "false" : "true"); };
  screen.querySelectorAll(".tok").forEach(t => t.onclick = () => {
    const on = !t.classList.contains("red"); t.classList.toggle("red", on); t.setAttribute("aria-pressed", on);
  });
  $("#check").onclick = () => {
    const toks = [...screen.querySelectorAll(".tok")];
    const need = toks.filter(t=>t.dataset.p==="1").length;
    const hit = toks.filter(t=>t.dataset.p==="1" && t.classList.contains("red")).length;
    const over = toks.filter(t=>t.dataset.p==="0" && t.classList.contains("red")).length;
    const pub = $("#pubSearch").getAttribute("aria-checked") === "true";
    if(hit === need && over === 0 && !pub){ toks.forEach(t=>t.disabled=true); $("#pubSearch").disabled=true; solved(L); return; }
    let msg = [];
    if(pub) msg.push("Der Regler <b>„Öffentliche Suche“</b> ist noch an. Damit ginge eine Google-Suchanfrage raus, die Daten aus eurem Prompt mitnehmen kann.");
    if(hit < need) msg.push(`Es sind noch <b>${need-hit}</b> besonders schützenswerte Angabe${need-hit>1?"n":""} sichtbar.`);
    if(over > 0) msg.push(`<b>${over}</b> geschwärzte Angabe${over>1?"n darf":" darf"} der S-KIPilot verarbeiten, und für die Zusammenfassung wird sie gebraucht.`);
    feedback(msg.join(" "), false);
  };
}

function debug(L){
  let r = 0;
  const draw = () => {
    const R = L.rounds[r];
    screen.innerHTML = header(L) + `<p class="round">Runde ${r+1} von ${L.rounds.length}: ${R.label}</p>
      <div class="plines">${R.lines.map((l,i)=>`<button class="pline" data-i="${i}"><span class="no">${i+1}</span><span>${esc(l)}</span></button>`).join("")}</div>
      <div class="outbox">${R.out}</div>` + footer(null);
    if(S.hintShown){ $("#hintBox").innerHTML = `<div class="hint">💡 ${L.hint}</div>`; $("#hintBtn").disabled = true; $("#hintBtn").style.opacity=.5; }
    else wireHint(L.hint);
    screen.querySelectorAll(".pline").forEach(b => b.onclick = () => {
      if(+b.dataset.i === R.bug){
        b.classList.add("right"); screen.querySelectorAll(".pline").forEach(x=>x.disabled=true);
        if(r < L.rounds.length - 1){
          feedback(`<b>Treffer!</b> ${R.why}`, true);
          $("#after").innerHTML = `<div class="actions"><button class="btn" id="nr">Nächste Runde</button></div>`;
          $("#nr").onclick = () => { r++; draw(); };
        } else { $("#hintBox").innerHTML = ""; feedback(`<b>Treffer!</b> ${R.why}`, true); solvedDebug(L); }
      } else {
        b.classList.add("wrong"); b.disabled = true;
        feedback("Diese Zeile ist unschuldig. Was genau ist im Ergebnis schiefgelaufen, und welche Anweisung führt direkt dazu?", false);
      }
    });
  };
  draw();
}
function solvedDebug(L){
  const keep = $("#fb").innerHTML;
  solved(L);
  $("#fb").className = "feedback show good"; $("#fb").innerHTML = keep;
}

function cloze(L){
  const filled = Array(L.answers.length).fill(null);
  const bank = shuffle([...L.answers, ...L.decoys]);
  let sel = null;
  const draw = () => {
    const used = filled.filter(Boolean);
    const tpl = esc(L.tpl).replace(/\n/g,"<br>").replace(/\{(\d)\}/g, (_,n) => `<button class="blank${filled[n]?"":" empty"}" data-n="${n}">${filled[n] ? esc(filled[n]) : "Lücke " + (+n+1)}</button>`);
    $("#tpl").innerHTML = tpl;
    $("#bank").innerHTML = bank.filter(w=>!used.includes(w)).map(w=>`<button class="chip${sel===w?" sel":""}">${esc(w)}</button>`).join("");
    $("#bank").querySelectorAll(".chip").forEach(c => c.onclick = () => { sel = sel === c.textContent ? null : c.textContent; draw(); });
    $("#tpl").querySelectorAll(".blank").forEach(b => b.onclick = () => {
      const n = +b.dataset.n;
      if(sel){ filled[n] = sel; sel = null; } else if(filled[n]) filled[n] = null;
      draw();
    });
  };
  screen.innerHTML = header(L) + `<div class="tpl" id="tpl"></div><p style="margin:16px 0 0;font-weight:700">Wortbank</p><div class="bank" id="bank"></div>` + footer("Vorlage prüfen");
  draw();
  $("#check").onclick = () => {
    if(filled.some(f=>!f)){ feedback(`Noch ${filled.filter(f=>!f).length} Lücke(n) offen.`, false); return; }
    let right = 0;
    $("#tpl").querySelectorAll(".blank").forEach(b => { const n=+b.dataset.n, ok = filled[n] === L.answers[n]; b.classList.toggle("right", ok); b.classList.toggle("wrong", !ok); if(ok) right++; });
    if(right === L.answers.length){ $("#tpl").querySelectorAll(".blank").forEach(b=>b.disabled=true); $("#bank").remove(); solved(L); }
    else feedback(`${right} von ${L.answers.length} Lücken sitzen. Die rot umrandeten tragen noch eine Falle des Maulwurfs.`, false);
  };
}

function sequence(L){
  const cards = shuffle([...L.steps.map((t,i)=>({t,i})), {t:L.trap, i:-1}]);
  const slots = Array(L.steps.length).fill(null);
  const draw = () => {
    $("#slots").innerHTML = slots.map((c,k)=>`<button class="slot${c?" filled":""}" data-k="${k}">${c ? esc(c.t) : "<span style='color:var(--muted)'>leer</span>"}</button>`).join("");
    $("#pool").innerHTML = cards.filter(c=>!slots.includes(c)).map(c=>`<button class="card" data-i="${cards.indexOf(c)}">${esc(c.t)}</button>`).join("");
    $("#slots").querySelectorAll(".slot").forEach(s => s.onclick = () => { slots[+s.dataset.k] = null; draw(); });
    $("#pool").querySelectorAll(".card").forEach(c => c.onclick = () => {
      const k = slots.indexOf(null); if(k < 0) return; slots[k] = cards[+c.dataset.i]; draw();
    });
  };
  screen.innerHTML = header(L) + `<div class="seq"><div><h4>Eure Kette</h4><div class="slots" id="slots"></div></div><div><h4>Kartenstapel</h4><div class="pool" id="pool"></div></div></div>` + footer("Kette prüfen");
  draw();
  $("#check").onclick = () => {
    if(slots.includes(null)){ feedback("Die Kette hat noch leere Plätze.", false); return; }
    const right = slots.filter((c,k)=>c.i === k).length;
    if(right === slots.length){
      $("#slots").querySelectorAll(".slot").forEach(s=>{s.classList.add("right");s.disabled=true;});
      $("#pool").querySelectorAll(".card").forEach(c=>{c.disabled=true;c.style.opacity=.5;c.style.textDecoration="line-through";});
      solved(L);
    } else {
      const trap = slots.some(c=>c.i === -1);
      feedback(`${right} von ${slots.length} Positionen stimmen.${trap ? " Und in eurer Kette steckt die Schmuggelkarte des Maulwurfs." : ""}`, false);
    }
  };
}

function mixer(L){
  const on = new Set();
  screen.innerHTML = header(L) + `<div class="mixer">${L.mods.map((m,i)=>`<button class="sw" role="switch" aria-checked="false" data-i="${i}"><span class="track"></span><span>${esc(m.t)}</span></button>`).join("")}</div>` + footer("Testlauf starten");
  screen.querySelectorAll(".sw").forEach(b => b.onclick = () => {
    const i = +b.dataset.i; on.has(i) ? on.delete(i) : on.add(i); b.setAttribute("aria-checked", on.has(i));
  });
  $("#check").onclick = () => {
    const good = L.mods.filter(m=>m.ok).length;
    const goodOn = [...on].filter(i=>L.mods[i].ok).length, badOn = [...on].filter(i=>!L.mods[i].ok).length;
    const score = Math.max(0, Math.round((goodOn / good) * 100 - badOn * 25));
    const fx = [...on].sort((a,b)=>a-b).map(i => `<li>${L.mods[i].ok ? "✅" : "⚠️"} ${L.mods[i].fx}</li>`).join("");
    const missing = good - goodOn;
    const box = `<div class="testrun"><b>Testlauf: Qualität des Entwurfs ${score} %</b>
      <div class="meter${badOn?" badm":""}"><i style="width:${score}%"></i></div>
      <ul class="effects">${fx || "<li>Kein Modul aktiv. Der S-KIPilot starrt euch fragend an.</li>"}${missing ? `<li>❔ Der Entwurf wirkt an ${missing} Stelle${missing>1?"n":""} noch unvollständig.</li>` : ""}</ul></div>`;
    $("#after").innerHTML = box;
    if(missing === 0 && badOn === 0){
      screen.querySelectorAll(".sw").forEach(b=>b.disabled=true);
      const keep = box; solved(L); $("#after").insertAdjacentHTML("afterbegin", keep);
    } else {
      feedback(badOn ? "Der Entwurf enthält Gift. Schaltet die problematischen Module ab." : "Kein Gift mehr drin, aber es fehlt noch etwas.", false);
    }
  };
}

/* ---------- Entlarvung ---------- */
function accuse(){
  screen.innerHTML = `<p class="kicker">Finale</p><h2>Die Entlarvung</h2>
    ${moleBox("Fünf Spuren, sechs Verdächtige. Na, wer war's? Ich wette, ihr ratet.")}
    <p class="task">Wer ist der Maulwurf? Prüft alle fünf Spuren und klagt an. Eine falsche Anklage kostet zwei Minuten.</p>
    <div class="lineup">${SUSPECTS.map((p,i)=>`<div>${susCard(p,i,false).replace("</div></div>", `</div><button class="btn" data-i="${i}">${esc(p.n.split(" ")[0])} anklagen</button></div>`)}</div>`).join("")}</div>
    <div class="feedback" id="fb"></div>`;
  screen.querySelectorAll(".lineup .btn").forEach(b => b.onclick = () => {
    const i = +b.dataset.i, p = SUSPECTS[i];
    if(i === MOLE){ S.done = true; S.endTime = Date.now(); tick(); ending(); return; }
    S.penalty += WRONG_ACCUSE; S.accusations++; tick();
    const k = CLUES.findIndex(c => p[c.key] !== c.val);
    feedback(`<b>Einspruch!</b> ${esc(p.n)} kann es nicht gewesen sein. Spur ${k+1}: ${CLUES[k].short} Passt nicht zu: ${ICON[CLUES[k].key][p[CLUES[k].key]]} ${p[CLUES[k].key]}. Zwei Minuten Abzug.`, false);
    b.disabled = true; b.style.opacity = .4; S.out.add(i); drawBoard();
  });
}

function ending(){
  const t = elapsed(), inTime = t <= TOTAL;
  const rank = t <= 22*60 && S.accusations === 0 ? "Meisterdetektive 🕵️" : inTime ? "Ermittlungsprofis 🥇" : "Spätermittler 🌙";
  screen.innerHTML = `<p class="kicker">Fall gelöst</p>
    <h2>${esc(S.team)}: ${rank}</h2>
    <p class="lead">Es war <strong>Sabine Seidel</strong> aus dem Marketing. Teetrinkerin, Nachteule, Radfahrerin, Linkshand, Büro im 2. OG. ${inTime ? "Um Punkt neun liegt die reparierte Prompt-Bibliothek beim Vorstand auf dem Tisch." : "Der Vorstand musste kurz warten, aber die reparierte Bibliothek überzeugt trotzdem."}</p>
    ${moleBox("Okay, erwischt. Ich wollte nur testen, ob irgendwer Vorlagen prüft, bevor er sie benutzt. Offenbar ja: ihr. Respekt.", "Geständnis von Sabine Seidel")}
    <div class="stats">
      <div><strong>${fmt(t)}</strong>Minuten gebraucht (inkl. Abzüge)</div>
      <div><strong>${S.hints}</strong>Tipp${S.hints===1?"":"s"} genutzt</div>
      <div><strong>${S.accusations}</strong>falsche Anklage${S.accusations===1?"":"n"}</div>
    </div>
    <h3>Euer Profi-Spickzettel</h3>
    <ol class="cheat">${STATIONS.map(l=>`<li>${l.lesson}</li>`).join("")}<li>Und die Moral von der Geschicht: Auch geprüfte Vorlagen prüft ihr vor jedem Einsatz noch einmal kurz. Vorlagen sind ein Startpunkt, kein Autopilot.</li></ol>
    <div class="actions"><button class="btn" id="again">Nochmal spielen</button></div>`;
  $("#again").onclick = () => location.reload();
  window.scrollTo({top:0,behavior:"smooth"});
}

drawBoard();
intro();
</script>

